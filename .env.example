# Copy to .env or set these as system environment variables.
DISCORD_TOKEN=your-bot-token
TARGET_CHANNEL_ID=123456789012345678

# Optional logging filter.
RUST_LOG=info,serenity=warn,poise=warn

# Optional AI generation. Omit GROQ_API_KEY to use built-in prompts only.
# Never check your actual API key into version control.
# GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
TOD_LANGUAGE=ka
# Where generated prompts are saved between restarts (default: prompt_store.json).
# PROMPT_STORE_PATH=prompt_store.json

# Where movie suggestions are saved between restarts (per Discord channel).
# MOVIE_STORE_PATH=movie_store.json
